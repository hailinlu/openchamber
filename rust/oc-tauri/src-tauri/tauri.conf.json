{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GridForge",
  "version": "0.1.0",
  "identifier": "com.gridforge.desktop",
  "build": {
    "frontendDist": "../ui-dist",
    "devUrl": "http://127.0.0.1:5180"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/hailinlu/gridforge/releases/latest/download/latest.json"
      ]
    }
  }
}
