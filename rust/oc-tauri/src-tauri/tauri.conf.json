{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenChamber",
  "version": "0.1.0",
  "identifier": "dev.openchamber.desktop",
  "build": {
    "frontendDist": "../ui-dist",
    "devUrl": "http://127.0.0.1:5180"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenChamber",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
