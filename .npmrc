# pnpm configuration for OpenChamber monorepo
registry=https://registry.npmjs.org/
electron_mirror=https://npmmirror.com/mirrors/electron/

# Hoist dependencies flat (like bun/npm workspaces) so scripts that
# reference root node_modules continue to work
shamefully-hoist=true
strict-peer-dependencies=false
auto-install-peers=true

# @electron/rebuild depends on @electron/node-gyp via git URL
# pnpm blocks exotic subdeps by default; disable that check
block-exotic-subdeps=false
